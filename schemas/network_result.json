{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NetworkResult",
  "description": "Schema for network investigation telemetry analysis",
  "type": "object",
  "required": [
    "indicator",
    "indicator_type",
    "query_time_range",
    "total_connections",
    "observed_evidence",
    "analytics",
    "evidence_items",
    "limitations",
    "provenance"
  ],
  "properties": {
    "indicator": {
      "type": "string",
      "description": "The IOC that was investigated"
    },
    "indicator_type": {
      "type": "string",
      "enum": [
        "ipv4",
        "domain"
      ],
      "description": "Type of indicator investigated"
    },
    "query_time_range": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "total_connections": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of connections observed"
    },
    "unique_destinations": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of unique destination IPs/domains"
    },
    "unique_ports": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of unique destination ports"
    },
    "failed_connections": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of failed connection attempts"
    },
    "successful_connections": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of successful connections"
    },
    "patterns_detected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string",
            "enum": [
              "port_scan",
              "high_frequency",
              "lateral_movement",
              "beaconing",
              "failed_connection_spike"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Specific evidence supporting this pattern detection"
          }
        },
        "required": [
          "pattern",
          "confidence"
        ]
      },
      "description": "Network patterns detected during investigation",
      "default": []
    },
    "connection_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dst": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "count": {
            "type": "integer"
          },
          "first_seen": {
            "type": "string",
            "format": "date-time"
          },
          "last_seen": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "dst",
          "port"
        ]
      },
      "description": "Summary of top connections by destination"
    },
    "observed_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "array",
              "object"
            ]
          },
          "context": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "description": "Raw network observables that support the analysis"
    },
    "total_alerts": {
      "type": "integer",
      "minimum": 0
    },
    "query_direction": {
      "type": "string",
      "enum": [
        "any",
        "src",
        "dst",
        "outbound",
        "inbound"
      ]
    },
    "source_summary": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "analytics": {
      "type": "object",
      "required": [
        "periodicity_candidates",
        "scan_candidates",
        "transfer_metrics",
        "service_fanout_candidates"
      ],
      "properties": {
        "periodicity_candidates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "scan_candidates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "transfer_metrics": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "service_fanout_candidates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "evidence_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "local_key",
          "evidence_class",
          "type",
          "source_name",
          "data"
        ],
        "properties": {
          "local_key": {
            "type": "string"
          },
          "evidence_class": {
            "type": "string",
            "enum": [
              "OBSERVED",
              "DERIVED"
            ]
          },
          "type": {
            "type": "string"
          },
          "source_name": {
            "type": "string"
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "data": {
            "type": "object"
          },
          "provenance": {
            "type": "object"
          },
          "related_local_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    }
  }
}
