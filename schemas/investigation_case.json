{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvestigationCase",
  "description": "Schema for complete investigation case with evidence and assessment",
  "type": "object",
  "required": [
    "case_id",
    "created_at",
    "initial_indicator",
    "tool_trace",
    "evidence",
    "hypotheses",
    "risk_level",
    "confidence",
    "limitations",
    "final_assessment",
    "supporting_evidence",
    "contradicting_evidence",
    "metadata"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Unique identifier for the investigation case"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "initial_indicator": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ipv4",
            "domain",
            "hash",
            "url",
            "hostname"
          ]
        },
        "value": {
          "type": "string"
        },
        "context": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ]
    },
    "tool_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "call_id": {
            "type": "string"
          },
          "tool": {
            "type": "string",
            "enum": [
              "cti_enrichment",
              "network_investigation",
              "endpoint_investigation"
            ]
          },
          "arguments": {
            "type": "object"
          },
          "result_summary": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "call_id",
          "tool",
          "arguments",
          "timestamp",
          "evidence_ids"
        ]
      },
      "description": "Sequence of tool calls made during the investigation"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "source_tool": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "data": {
            "type": "object"
          },
          "collected_at": {
            "type": "string",
            "format": "date-time"
          },
          "linked_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_name": {
            "type": "string"
          },
          "evidence_class": {
            "type": "string",
            "enum": [
              "OBSERVED",
              "DERIVED",
              "EXTERNAL_INTEL"
            ]
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "confidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance": {
            "type": "object"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "evidence_id",
          "source_tool",
          "source_name",
          "evidence_class",
          "type",
          "data",
          "collected_at",
          "observed_at",
          "confidence",
          "provenance",
          "references",
          "related_evidence_ids",
          "linked_from"
        ]
      },
      "description": "All evidence collected during the investigation"
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "Human-readable hypothesis description"
          },
          "supporting_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Evidence IDs that support this hypothesis"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          }
        },
        "required": [
          "id",
          "description",
          "supporting_evidence",
          "confidence"
        ]
      },
      "description": "Possible explanations based on collected evidence"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL",
        "UNKNOWN"
      ],
      "description": "Overall risk assessment"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "description": "Confidence in the overall assessment"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Known limitations or gaps in the investigation",
      "default": []
    },
    "final_assessment": {
      "type": "string",
      "description": "Summary assessment combining all evidence and analysis"
    },
    "supporting_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Evidence IDs that support the final assessment"
    },
    "contradicting_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Evidence IDs that contradict or complicate the final assessment"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "investigation_duration_seconds": {
          "type": "number"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stage": {
                "type": "string"
              },
              "error": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
