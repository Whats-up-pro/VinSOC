{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "soc_investigation_case_v1",
  "description": "Schema for complete investigation case with evidence and assessment",
  "type": "object",
  "required": [
    "case_id",
    "created_at",
    "initial_indicator",
    "tool_trace",
    "evidence",
    "hypotheses",
    "risk_level",
    "confidence",
    "limitations",
    "final_assessment",
    "supporting_evidence",
    "contradicting_evidence",
    "metadata"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Unique identifier for the investigation case"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "initial_indicator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "alert"
            },
            "alert": {
              "type": "object"
            }
          },
          "required": [
            "kind",
            "alert"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ioc"
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "indicator_type": {
              "enum": [
                "ipv4",
                "domain",
                "hash",
                "url"
              ]
            }
          },
          "required": [
            "kind",
            "value",
            "indicator_type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "tool_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "call_id": {
            "type": "string"
          },
          "tool": {
            "type": "string",
            "enum": [
              "soc_search_events",
              "soc_get_context"
            ]
          },
          "arguments": {
            "type": "object"
          },
          "result_summary": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "call_id",
          "tool",
          "arguments",
          "timestamp",
          "evidence_ids"
        ]
      },
      "description": "Sequence of tool calls made during the investigation"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "source_tool": {
            "type": "string",
            "enum": [
              "soc_input",
              "soc_search_events",
              "soc_get_context"
            ]
          },
          "source_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_class": {
            "type": "string",
            "enum": [
              "OBSERVED",
              "DERIVED",
              "EXTERNAL_INTEL"
            ]
          },
          "type": {
            "type": "string"
          },
          "data": {
            "type": "object"
          },
          "collected_at": {
            "type": "string",
            "format": "date-time"
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "confidence": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "low",
              "medium",
              "high",
              null
            ]
          },
          "provenance": {
            "type": "object"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "linked_from": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "evidence_id",
          "source_tool",
          "evidence_class",
          "type",
          "data",
          "collected_at",
          "linked_from",
          "provenance",
          "references",
          "related_evidence_ids"
        ]
      },
      "description": "All evidence collected during the investigation. Evidence V2 requires evidence_class, provenance, references, and related_evidence_ids."
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "Human-readable hypothesis description"
          },
          "supporting_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Evidence IDs that support this hypothesis"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          }
        },
        "required": [
          "id",
          "description",
          "supporting_evidence",
          "confidence"
        ]
      },
      "description": "Possible explanations based on collected evidence"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL",
        "UNKNOWN"
      ],
      "description": "Overall risk assessment"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "description": "Confidence in the overall assessment"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Known limitations or gaps in the investigation",
      "default": []
    },
    "final_assessment": {
      "type": "string",
      "description": "Summary assessment combining all evidence and analysis"
    },
    "supporting_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Evidence IDs that support the final assessment"
    },
    "contradicting_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Evidence IDs that contradict or complicate the final assessment"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "investigation_duration_seconds": {
          "type": "number"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stage": {
                "type": "string"
              },
              "error": {
                "type": "string"
              }
            }
          }
        },
        "soc_report": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "verdict": {
              "type": "string",
              "enum": [
                "malicious",
                "benign",
                "insufficient_evidence"
              ]
            },
            "hypotheses": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "supporting_evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "contradicting_evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "LOW",
                      "MEDIUM",
                      "HIGH"
                    ]
                  }
                },
                "required": [
                  "description",
                  "supporting_evidence",
                  "contradicting_evidence",
                  "confidence"
                ],
                "additionalProperties": false
              }
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "claim": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "observed",
                      "inferred"
                    ]
                  }
                },
                "required": [
                  "claim",
                  "evidence_ids",
                  "kind"
                ],
                "additionalProperties": false
              }
            },
            "risk_level": {
              "type": "string",
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH",
                "CRITICAL",
                "UNKNOWN"
              ]
            },
            "risk_rationale": {
              "type": "string",
              "minLength": 1
            },
            "confidence": {
              "type": "string",
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH"
              ]
            },
            "confidence_rationale": {
              "type": "string",
              "minLength": 1
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "recommended_actions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "action",
                  "rationale",
                  "evidence_ids"
                ],
                "additionalProperties": false
              }
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "summary",
            "verdict",
            "hypotheses",
            "findings",
            "risk_level",
            "risk_rationale",
            "confidence",
            "confidence_rationale",
            "limitations",
            "recommended_actions",
            "evidence_ids"
          ],
          "additionalProperties": false,
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "soc_investigation_report_v1"
        }
      }
    }
  }
}
