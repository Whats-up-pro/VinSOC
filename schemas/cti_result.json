{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CTIResult",
  "description": "Schema for Cyber Threat Intelligence enrichment results",
  "type": "object",
  "required": [
    "indicator",
    "indicator_type",
    "reputation",
    "confidence"
  ],
  "properties": {
    "indicator": {
      "type": "string",
      "description": "The original IOC value that was enriched",
      "examples": [
        "192.168.1.100",
        "malware.example.com",
        "d41d8cd98f00b204e9800998ecf8427e"
      ]
    },
    "indicator_type": {
      "type": "string",
      "enum": [
        "ipv4",
        "domain",
        "hash",
        "url"
      ],
      "description": "The type of indicator"
    },
    "reputation": {
      "type": "string",
      "enum": [
        "benign",
        "suspicious",
        "malicious",
        "unknown"
      ],
      "description": "Reputation assessment from CTI sources"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "Confidence level in the reputation assessment"
    },
    "related_actors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Threat actors associated with this indicator",
      "default": []
    },
    "related_malware": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Malware families associated with this indicator",
      "default": []
    },
    "mitre_techniques": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "technique_id": {
            "type": "string",
            "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
          },
          "technique_name": {
            "type": "string"
          },
          "tactics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "technique_id",
          "technique_name"
        ]
      },
      "description": "MITRE ATT&CK techniques associated with this indicator",
      "default": []
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "last_updated": {
            "type": "string",
            "format": "date-time"
          },
          "reference": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "name"
        ]
      },
      "description": "CTI sources that provided information about this indicator",
      "default": []
    },
    "observed_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "context": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "description": "Raw CTI observables that support the reputation assessment"
    },
    "raw_enrichment": {
      "type": "object",
      "description": "Provider-specific raw enrichment data (optional, for debugging)"
    },
    "primary_source": {
      "type": "string",
      "description": "Primary provider used for normalized enrichment"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "External intelligence references"
    },
    "provenance": {
      "type": "object",
      "description": "Provider/query metadata retained for auditability"
    }
  }
}
