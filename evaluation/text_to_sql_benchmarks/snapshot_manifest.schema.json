{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VinSOCTextToSQLSnapshotManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "path",
    "sha256",
    "schema_version"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_version": {
      "const": "1"
    }
  }
}
