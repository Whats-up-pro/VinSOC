{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VinSOCPublicDatasetManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_id",
          "source_name",
          "source_url",
          "retrieved_at",
          "file_sha256",
          "license_note",
          "format",
          "path",
          "archive_member"
        ],
        "properties": {
          "dataset_id": {
            "type": "string",
            "minLength": 1
          },
          "source_name": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "file_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "license_note": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "enum": [
              "threatfox_csv",
              "ctu13_binetflow",
              "sysmon_jsonl",
              "sysmon_zip_jsonl"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "archive_member": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
