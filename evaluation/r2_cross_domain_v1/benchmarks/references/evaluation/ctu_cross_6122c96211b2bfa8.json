  "question": "Return dataset/protocol flow counts exceeding that dataset's average protocol-group count; order by dataset then protocol.",
  "gold_sql": "WITH groups AS (SELECT source_dataset,protocol,COUNT(*) AS n FROM network_flows GROUP BY source_dataset,protocol) SELECT g.source_dataset,g.protocol,g.n FROM groups g WHERE g.n>(SELECT AVG(other.n) FROM groups other WHERE other.source_dataset=g.source_dataset) ORDER BY g.source_dataset,g.protocol",
